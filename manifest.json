{
  "manifest_version": 3,
  "name": "Shofee - Riset Produk Marketplace",
  "version": "1.3.0",
  "description": "Riset produk & toko kompetitor di Shopee langsung dari tampilan halaman: estimasi omzet, penjualan, filter, export CSV.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://shopee.co.id/*",
    "https://temanseller.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Shofee",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.co.id/*"
      ],
      "js": [
        "src/apiparse.js",
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.co.id/*"
      ],
      "js": [
        "src/apiparse.js",
        "src/audit-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://shopee.co.id/*"
      ],
      "js": [
        "src/audit-parse.js",
        "src/audit-collect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://shopee.co.id/*"
      ],
      "js": [
        "src/parser.js",
        "src/store.js",
        "src/license.js",
        "src/ui.js",
        "src/inline.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://temanseller.com/audit*"
      ],
      "js": [
        "src/audit-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "version_name": "1.3.0 (Marketplace Audit)"
}